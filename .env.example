# Sleutel voor de coach. Zet deze in de Replit Secrets, niet in een bestand
# dat in git terechtkomt. Zonder sleutel werkt de app gewoon; alleen de
# coachlaag is dan uitgeschakeld.
OPENAI_API_KEY=

# Welk model de coach gebruikt. Modelnamen bij OpenAI veranderen regelmatig en
# welke beschikbaar zijn hangt af van je account. Roep /api/coach/models aan om
# te zien wat jouw sleutel mag gebruiken. Standaard: gpt-4o
OPENAI_MODEL=

# Poort waarop de server luistert. Replit zet deze zelf.
PORT=3001
